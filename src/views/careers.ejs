<%- include('partials/header', { page: 'careers' }) %>

    <!-- Main Container: Light Theme for consistency -->
    <div class="bg-gray-50 font-sans text-gray-600 relative selection:bg-brand-secondary selection:text-white">

        <!-- Hero Section: Dark & Cool ("Elite" Vibe) -->
        <div class="relative bg-brand-dark pt-16 pb-24 lg:pt-24 lg:pb-32 overflow-hidden">
            <!-- Abstract Background Effects -->
            <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none">
                <div
                    class="absolute top-[-10%] left-[-10%] w-[40rem] h-[40rem] bg-brand-primary/20 rounded-full blur-[100px] animate-blob">
                </div>
                <div
                    class="absolute top-[20%] right-[-10%] w-[35rem] h-[35rem] bg-brand-secondary/10 rounded-full blur-[100px] animate-blob animation-delay-2000">
                </div>
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
                <h1 class="text-5xl font-extrabold tracking-tight text-white sm:text-7xl mb-6" data-aos="fade-down">
                    Únete a la <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-brand-secondary to-blue-400">Élite
                        Tecnológica</span>
                </h1>
                <p class="mt-4 max-w-2xl mx-auto text-xl text-gray-300 leading-relaxed" data-aos="fade-up"
                    data-aos-delay="100">
                    Buscamos mentes brillantes que no se conforman con lo convencional. Desafía lo imposible en un
                    entorno de excelencia técnica.
                </p>
                <div class="mt-10 flex justify-center gap-4" data-aos="fade-up" data-aos-delay="200">
                    <a href="#openings"
                        class="btn-primary shadow-lg shadow-brand-primary/20 text-lg px-10 py-4 border-none">
                        Ver Posiciones
                    </a>
                </div>
            </div>

            <!-- Curve/Transition removed for cleaner look -->
        </div>

        <!-- Values Section (Grid of 3) -->
        <div class="relative z-10 py-20">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Value 1: Cultura de Aprendizaje -->
                    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden group hover:-translate-y-2 transition-all duration-300 h-full flex flex-col"
                        data-aos="fade-up" data-aos-delay="100">
                        <div class="h-48 overflow-hidden relative">
                            <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=800&q=80"
                                alt="Learning"
                                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                            <div
                                class="absolute inset-0 bg-brand-primary/30 group-hover:bg-brand-primary/10 transition-colors duration-500">
                            </div>
                            <div
                                class="absolute bottom-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-brand-primary shadow-sm">
                                <i class="fa-solid fa-rocket mr-1"></i> Evolución
                            </div>
                        </div>
                        <div class="p-8">
                            <h3 class="text-xl font-bold text-brand-dark mb-3">Crecimiento Continuo</h3>
                            <p class="text-gray-500 text-sm leading-relaxed">
                                Fomentamos un entorno donde el intercambio de conocimientos es natural. Evoluciona con
                                nosotros enfrentando retos reales cada día.
                            </p>
                        </div>
                    </div>

                    <!-- Value 2: Flexibilidad Total -->
                    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden group hover:-translate-y-2 transition-all duration-300 h-full flex flex-col"
                        data-aos="fade-up" data-aos-delay="200">
                        <div class="h-48 overflow-hidden relative">
                            <img src="https://images.unsplash.com/photo-1593642532973-d31b6557fa68?auto=format&fit=crop&w=800&q=80"
                                alt="Remote Work"
                                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                            <div
                                class="absolute inset-0 bg-brand-primary/30 group-hover:bg-brand-primary/10 transition-colors duration-500">
                            </div>
                            <div
                                class="absolute bottom-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-brand-primary shadow-sm">
                                <i class="fa-solid fa-earth-americas mr-1"></i> Remote-First
                            </div>
                        </div>
                        <div class="p-8">
                            <h3 class="text-xl font-bold text-brand-dark mb-3">Flexibilidad Total</h3>
                            <p class="text-gray-500 text-sm leading-relaxed">
                                Trabaja desde donde seas más productivo. Somos una empresa 100% remota con horarios
                                flexibles y conciliación real.
                            </p>
                        </div>
                    </div>

                    <!-- Value 3: Retos Técnicos -->
                    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden group hover:-translate-y-2 transition-all duration-300 h-full flex flex-col"
                        data-aos="fade-up" data-aos-delay="300">
                        <div class="h-48 overflow-hidden relative">
                            <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=800&q=80"
                                alt="Technical Challenges"
                                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                            <div
                                class="absolute inset-0 bg-brand-primary/30 group-hover:bg-brand-primary/10 transition-colors duration-500">
                            </div>
                            <div
                                class="absolute bottom-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-brand-primary shadow-sm">
                                <i class="fa-solid fa-laptop-code mr-1"></i> Innovación
                            </div>
                        </div>
                        <div class="p-8">
                            <h3 class="text-xl font-bold text-brand-dark mb-3">Retos Técnicos</h3>
                            <p class="text-gray-500 text-sm leading-relaxed">
                                Olvídate de la rutina. Resolverás problemas complejos de seguridad y arquitectura en
                                infraestructuras críticas.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Jobs Section -->
        <div id="openings" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
            <div class="flex items-center mb-10">
                <span class="w-1.5 h-8 bg-brand-primary rounded-full mr-4"></span>
                <h2 class="text-3xl font-bold text-brand-dark">Posiciones Abiertas</h2>
            </div>

            <div class="bg-white rounded-2xl p-12 text-center border border-gray-100 shadow-sm" data-aos="fade-up">
                <div class="mb-6">
                    <i class="fa-solid fa-briefcase text-5xl text-gray-200"></i>
                </div>
                <h3 class="text-xl font-bold text-brand-dark mb-2">De momento no hay ninguna posición abierta</h3>
                <p class="text-gray-500 max-w-md mx-auto">
                    Aunque no tengamos vacantes activas ahora mismo, siempre estamos interesados en conocer talento
                    excepcional para futuras oportunidades.
                </p>
            </div>

            <!-- Spontaneous Application -->
            <div class="mt-20 text-center" data-aos="fadeIn">
                <div
                    class="bg-white rounded-2xl px-10 py-12 border border-gray-100 shadow-lg inline-block w-full max-w-4xl">
                    <h3 class="text-2xl font-bold text-brand-dark mb-4">¿No encuentras tu posición?</h3>
                    <p class="text-gray-500 mb-8 max-w-xl mx-auto">
                        Si crees que puedes aportar valor a nuestro equipo, ¡te queremos conocer! Envíanos tu
                        candidatura espontánea y la tendremos en cuenta.
                    </p>
                    <button type="button" id="btn-open-modal"
                        class="btn-primary inline-flex items-center text-xl px-10 py-4 cursor-pointer">
                        Enviar CV Espontáneo <i class="fa-solid fa-paper-plane ml-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- CV Submission Modal (Seidor Style) -->
    <div id="cv-modal"
        class="fixed inset-0 hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm z-[99999]">
        <!-- Background Overlay (Click to close) -->
        <div id="btn-close-overlay" class="absolute inset-0 cursor-pointer w-full h-full bg-transparent"></div>

        <!-- Modal Panel -->
        <div
            class="relative bg-white rounded-3xl text-left shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-y-auto z-[100000]">
            <!-- Close Button -->
            <button type="button" id="btn-close-modal"
                class="absolute top-6 right-6 text-gray-500 hover:text-brand-dark transition-colors z-50 w-12 h-12 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 cursor-pointer">
                <i class="fa-solid fa-xmark text-2xl"></i>
            </button>

            <div class="p-10 md:p-14">
                <div class="text-center mb-10">
                    <h2 class="text-4xl md:text-5xl font-extrabold text-[#001D3D] tracking-tight leading-tight">
                        ¿No encuentras una oportunidad que se adapte a tu perfil?
                    </h2>
                </div>

                <form action="/careers/submit" method="POST" enctype="multipart/form-data" class="space-y-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6">
                        <div class="space-y-2">
                            <label for="cv-name" class="block text-sm font-bold text-gray-700">Nombre<span
                                    class="text-red-500 ml-1 text-base">*</span></label>
                            <input type="text" name="name" id="cv-name" required
                                class="block w-full bg-[#F1F4F9] border-none rounded-2xl py-4 px-5 text-brand-dark focus:ring-2 focus:ring-brand-primary outline-none transition-all">
                        </div>
                        <div class="space-y-2">
                            <label for="cv-surname" class="block text-sm font-bold text-gray-700">Apellido<span
                                    class="text-red-500 ml-1 text-base">*</span></label>
                            <input type="text" name="surname" id="cv-surname" required
                                class="block w-full bg-[#F1F4F9] border-none rounded-2xl py-4 px-5 text-brand-dark focus:ring-2 focus:ring-brand-primary outline-none transition-all">
                        </div>
                        <div class="space-y-2">
                            <label for="cv-email" class="block text-sm font-bold text-gray-700">Email<span
                                    class="text-red-500 ml-1 text-base">*</span></label>
                            <input type="email" name="email" id="cv-email" required
                                class="block w-full bg-[#F1F4F9] border-none rounded-2xl py-4 px-5 text-brand-dark focus:ring-2 focus:ring-brand-primary outline-none transition-all">
                        </div>
                        <div class="space-y-2">
                            <label for="cv-phone" class="block text-sm font-bold text-gray-700">Teléfono <span
                                    class="text-gray-400 font-normal text-xs ml-1">(opcional)</span></label>
                            <input type="tel" name="phone" id="cv-phone"
                                class="block w-full bg-[#F1F4F9] border-none rounded-2xl py-4 px-5 text-brand-dark focus:ring-2 focus:ring-brand-primary outline-none transition-all"
                                placeholder="+34 612 345 678">
                        </div>
                    </div>

                    <div class="space-y-3">
                        <label for="cv-file" class="block text-sm font-bold text-gray-700">Adjuntar CV<span
                                class="text-red-500 ml-1 text-base">*</span></label>
                        <div class="flex items-center gap-4">
                            <label for="cv-file"
                                class="cursor-pointer bg-white border border-gray-300 rounded-lg px-6 py-2 text-sm font-medium hover:bg-gray-50 transition-colors">
                                Seleccionar archivo
                                <input id="cv-file" name="cv" type="file" class="sr-only" required accept=".pdf">
                            </label>
                            <span id="file-name" class="text-gray-500 text-sm italic">Ningún archivo seleccionado</span>
                        </div>
                    </div>

                    <p class="text-[11px] text-gray-500 leading-relaxed max-w-4xl">
                        Al completar el presente formulario, autorizas expresamente a FastCenter OÜ. y a las empresas de
                        su Grupo, como responsable del tratamiento de los datos personales que nos facilitas, a tramitar
                        tu solicitud de información de conformidad con la normativa vigente en materia de protección de
                        datos. Podrás ejercitar tus derechos enviando un correo a <span
                            class="text-brand-secondary underline">info@fastcenter.eu</span>. Conservaremos tus datos
                        hasta que nos indiques lo contrario.
                    </p>

                    <div class="pt-4">
                        <button type="submit"
                            class="bg-[#56CCF2] hover:bg-[#2D9CDB] text-white px-10 py-4 rounded-full font-bold text-sm transition-all shadow-lg hover:shadow-xl">
                            Enviar solicitud
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // File input name update
            const cvFileInput = document.getElementById('cv-file');
            if (cvFileInput) {
                cvFileInput.addEventListener('change', function () {
                    const fileName = this.files[0] ? this.files[0].name : 'Ningún archivo seleccionado';
                    const fileNameSpan = document.getElementById('file-name');
                    if (fileNameSpan) fileNameSpan.textContent = fileName;
                });
            }

            // Modal Toggle Logic
            const modal = document.getElementById('cv-modal');
            const btnOpen = document.getElementById('btn-open-modal');
            const btnClose = document.getElementById('btn-close-modal');
            const btnOverlay = document.getElementById('btn-close-overlay');

            function openModal() {
                if (!modal) return;
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.style.overflow = 'hidden';
            }

            function closeModal() {
                if (!modal) return;
                modal.classList.remove('flex');
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }

            if (btnOpen) btnOpen.addEventListener('click', openModal);
            if (btnClose) btnClose.addEventListener('click', closeModal);
            if (btnOverlay) btnOverlay.addEventListener('click', closeModal);
        });
    </script>

    <%- include('partials/footer') %>