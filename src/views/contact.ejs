<%- include('partials/header', { page: 'contact' }) %>

    <div class="relative bg-gray-50 overflow-hidden">
        <!-- Abstract Background -->
        <div class="absolute inset-0 z-0">
            <img src="https://images.unsplash.com/photo-1557683316-973673baf926?auto=format&fit=crop&w=1600&q=80"
                alt="World Map Background" class="w-full h-full object-cover opacity-5 grayscale">
            <div class="absolute inset-0 bg-gradient-to-b from-white/80 to-white/40"></div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-16 pb-12">
            <div class="text-center mb-16" data-aos="fade-down">
                <h1 class="text-4xl font-extrabold text-brand-dark sm:text-5xl mb-4">
                    ¿Tienes una idea en mente?
                </h1>
                <p class="max-w-2xl mx-auto text-xl text-gray-500">
                    Cuéntanos tu proyecto y descubre cómo nuestra ingeniería puede ayudarte a desarrollarlo.
                </p>
            </div>

            <div data-aos="fade-up"
                class="max-w-5xl mx-auto glass-panel bg-white/90 rounded-xl shadow-2xl overflow-hidden border border-gray-100 flex flex-col md:flex-row">

                <!-- Info Section -->
                <div class="bg-brand-primary p-12 md:w-5/12 text-white relative overflow-hidden">
                    <div
                        class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 bg-brand-secondary opacity-20 rounded-full blur-3xl">
                    </div>
                    <div
                        class="absolute bottom-0 left-0 -ml-16 -mb-16 w-64 h-64 bg-brand-dark opacity-10 rounded-full blur-3xl">
                    </div>

                    <div class="relative z-10 space-y-10">
                        <div>
                            <h3 class="text-2xl font-bold mb-6">Información de Contacto</h3>
                            <p class="text-blue-100 leading-relaxed">Estamos a su disposición para resolver cualquier
                                duda o discutir nuevos proyectos.</p>
                        </div>

                        <div class="space-y-4">
                            <div>
                                <span class="text-white font-bold">Teléfono:</span>
                                <span class="text-blue-100 ml-2">+34 634433604</span>
                            </div>
                            <div>
                                <span class="text-white font-bold">Email:</span>
                                <span class="text-blue-100 ml-2">info@fastcenter.eu</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Section -->
                <div class="p-12 md:w-7/12">
                    <form action="/contact" method="POST" class="space-y-6">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="name" class="block text-sm font-bold text-gray-700">Nombre<span
                                        class="text-red-500 ml-1">*</span></label>
                                <input type="text" name="name" id="name" required
                                    class="mt-1 block w-full bg-gray-50 border border-gray-300 rounded-md shadow-sm py-3 px-4 text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-primary focus:border-brand-primary transition-all duration-200 sm:text-sm">
                            </div>
                            <div>
                                <label for="surname" class="block text-sm font-bold text-gray-700">Apellido<span
                                        class="text-red-500 ml-1">*</span></label>
                                <input type="text" name="surname" id="surname" required
                                    class="mt-1 block w-full bg-gray-50 border border-gray-300 rounded-md shadow-sm py-3 px-4 text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-primary focus:border-brand-primary transition-all duration-200 sm:text-sm">
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="email" class="block text-sm font-bold text-gray-700">Email
                                    corporativo<span class="text-red-500 ml-1">*</span></label>
                                <input type="email" name="email" id="email" required
                                    class="mt-1 block w-full bg-gray-50 border border-gray-300 rounded-md shadow-sm py-3 px-4 text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-primary focus:border-brand-primary transition-all duration-200 sm:text-sm">
                            </div>
                            <div>
                                <label for="phone" class="block text-sm font-bold text-gray-700">Teléfono <span
                                        class="text-gray-400 font-normal text-xs ml-1">(opcional)</span></label>
                                <input type="tel" name="phone" id="phone"
                                    class="mt-1 block w-full bg-gray-50 border border-gray-300 rounded-md shadow-sm py-3 px-4 text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-primary focus:border-brand-primary transition-all duration-200 sm:text-sm"
                                    placeholder="+34 612 345 678">
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="company" class="block text-sm font-bold text-gray-700">Empresa<span
                                        class="text-red-500 ml-1">*</span></label>
                                <input type="text" name="company" id="company" required
                                    class="mt-1 block w-full bg-gray-50 border border-gray-300 rounded-md shadow-sm py-3 px-4 text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-primary focus:border-brand-primary transition-all duration-200 sm:text-sm">
                            </div>
                            <div>
                                <label for="country" class="block text-sm font-bold text-gray-700">País<span
                                        class="text-red-500 ml-1">*</span></label>
                                <input type="text" name="country" id="country" required
                                    class="mt-1 block w-full bg-gray-50 border border-gray-300 rounded-md shadow-sm py-3 px-4 text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-primary focus:border-brand-primary transition-all duration-200 sm:text-sm">
                            </div>
                        </div>
                        <div>
                            <label for="message" class="block text-sm font-bold text-gray-700">Descripción del
                                proyecto o solicitud<span class="text-red-500 ml-1">*</span></label>
                            <textarea id="message" name="message" rows="4" required
                                class="mt-1 block w-full bg-gray-50 border border-gray-300 rounded-md shadow-sm py-3 px-4 text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-primary focus:border-brand-primary transition-all duration-200 sm:text-sm"></textarea>
                        </div>
                        <div class="pt-2">
                            <button type="submit"
                                class="w-full flex justify-center py-4 px-6 border border-transparent rounded-md shadow-md text-base font-bold text-white bg-brand-primary hover:bg-brand-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-primary transition-all duration-300">
                                Enviar Consulta Empresarial
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>