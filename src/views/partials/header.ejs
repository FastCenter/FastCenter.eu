<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title + ' | ' + appName : appName %>
    </title>
    <meta name="description" content="FastCenter - Advanced Cybersecurity & Custom Software Development.">
    <!-- Tailwind CSS (CDN for immediate visual fix) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            primary: '#003366', // Deep Corporate Blue
                            secondary: '#00AEEF', // Bright Cyan/Blue
                            accent: '#38bdf8', // Sky Blue
                            dark: '#111827', // Dark Gray
                            light: '#F3F4F6', // Light Gray
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                    },
                    animation: {
                        'blob': 'blob 7s infinite',
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'entrance-slide-up': 'slideUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards',
                    },
                    keyframes: {
                        blob: {
                            '0%': { transform: 'translate(0px, 0px) scale(1)' },
                            '33%': { transform: 'translate(30px, -50px) scale(1.1)' },
                            '66%': { transform: 'translate(-20px, 20px) scale(0.9)' },
                            '100%': { transform: 'translate(0px, 0px) scale(1)' },
                        },
                        slideUp: {
                            '0%': { transform: 'translateY(100px)', opacity: '0' },
                            '100%': { transform: 'translateY(0)', opacity: '1' },
                        }
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer components {
            .glass-panel {
                @apply bg-white/70 backdrop-blur-lg border border-white/20 shadow-xl;
            }
            .text-gradient {
                @apply bg-clip-text text-transparent bg-gradient-to-r from-brand-primary to-brand-secondary;
            }
            .btn-primary {
                @apply bg-brand-primary border-2 border-transparent text-white font-semibold py-3 px-8 rounded-md hover:bg-brand-secondary shadow-md transition-all duration-300 ease-in-out cursor-pointer inline-flex items-center justify-center;
            }
        }
    </style>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;700;800&display=swap"
        rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
</head>

<body
    class="flex flex-col min-h-screen bg-brand-light text-brand-dark antialiased font-sans selection:bg-brand-primary selection:text-white">
    <!-- Navigation -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                <div class="flex">
                    <div class="flex-shrink-0 flex items-center">
                        <!-- Logo -->
                        <a href="/" class="flex items-center gap-3 group">
                            <div
                                class="w-10 h-10 rounded-md bg-brand-primary flex items-center justify-center text-white font-sans font-bold text-xl shadow-sm">
                                F
                            </div>
                            <span
                                class="font-sans font-bold text-xl tracking-tight text-brand-primary group-hover:text-brand-secondary transition-colors duration-300">
                                <%= appName %>
                            </span>
                        </a>
                    </div>
                </div>
                <div class="hidden sm:ml-6 sm:flex sm:space-x-8 items-center">
                    <a href="/"
                        class="<%= (typeof page !== 'undefined' && page === 'home') ? 'text-brand-primary border-b-2 border-brand-primary' : 'text-gray-500 hover:text-brand-primary hover:border-b-2 hover:border-brand-primary/30' %> inline-flex items-center px-1 pt-1 text-sm font-medium transition-all duration-200 h-full border-b-2 border-transparent">
                        Inicio
                    </a>
                    <!-- Servicios Dropdown -->
                    <div class="relative group h-full flex items-center">
                        <button
                            class="<%= (typeof page !== 'undefined' && page.startsWith('services')) ? 'text-brand-primary border-b-2 border-brand-primary' : 'text-gray-500 hover:text-brand-primary hover:border-b-2 hover:border-brand-primary/30' %> inline-flex items-center px-1 pt-1 text-sm font-medium transition-all duration-200 h-full border-b-2 border-transparent outline-none cursor-pointer">
                            Servicios
                            <i
                                class="fa-solid fa-chevron-down ml-1 text-[10px] transition-transform duration-200 group-hover:rotate-180"></i>
                        </button>

                        <!-- Dropdown Menu -->
                        <div
                            class="absolute top-full left-1/2 transform -translate-x-1/2 mt-0 w-64 bg-white rounded-b-lg shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                            <div class="py-2">
                                <a href="/services/cybersecurity"
                                    class="block px-4 py-3 text-sm text-gray-700 hover:bg-brand-primary/5 hover:text-brand-primary transition-colors border-l-2 border-transparent hover:border-brand-primary">
                                    <div class="font-bold">Ciberseguridad</div>
                                    <div class="text-xs text-gray-400 font-normal mt-0.5">Auditoría y protección
                                        avanzada</div>
                                </a>
                                <a href="/services/software"
                                    class="block px-4 py-3 text-sm text-gray-700 hover:bg-brand-primary/5 hover:text-brand-primary transition-colors border-l-2 border-transparent hover:border-brand-primary">
                                    <div class="font-bold">Desarrollo de Software</div>
                                    <div class="text-xs text-gray-400 font-normal mt-0.5">Soluciones a medida Secure By
                                        Design</div>
                                </a>
                                <a href="/services/web"
                                    class="block px-4 py-3 text-sm text-gray-700 hover:bg-brand-primary/5 hover:text-brand-primary transition-colors border-l-2 border-transparent hover:border-brand-primary">
                                    <div class="font-bold">Diseño Web</div>
                                    <div class="text-xs text-gray-400 font-normal mt-0.5">Presencia digital de alto
                                        rendimiento</div>
                                </a>
                            </div>
                        </div>
                    </div>
                    <a href="/about"
                        class="<%= (typeof page !== 'undefined' && page === 'about') ? 'text-brand-primary border-b-2 border-brand-primary' : 'text-gray-500 hover:text-brand-primary hover:border-b-2 hover:border-brand-primary/30' %> inline-flex items-center px-1 pt-1 text-sm font-medium transition-all duration-200 h-full border-b-2 border-transparent">
                        Nosotros
                    </a>
                    <a href="/careers"
                        class="<%= (typeof page !== 'undefined' && page === 'careers') ? 'text-brand-primary border-b-2 border-brand-primary' : 'text-gray-500 hover:text-brand-primary hover:border-b-2 hover:border-brand-primary/30' %> inline-flex items-center px-1 pt-1 text-sm font-medium transition-all duration-200 h-full border-b-2 border-transparent">
                        Talento
                    </a>
                    <a href="/contact"
                        class="ml-4 bg-brand-primary text-white px-5 py-2.5 rounded-md font-medium text-sm shadow-sm">
                        Contacto
                    </a>
                </div>
                <!-- Mobile menu button placeholder -->
                <div class="-mr-2 flex items-center sm:hidden">
                    <a href="/contact" class="text-brand-primary font-medium">Menu</a>
                </div>
            </div>
        </div>
    </nav>